<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Dépôt autonome (multi-repo). Hérite directement du parent Spring Boot. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.continuum</groupId>
  <artifactId>continuum-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>continuum-backend</name>
  <description>Monolithe modulaire Spring Boot / Spring Modulith — API partagee app + admin (plan §4.3)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-modulith.version>1.3.1</spring-modulith.version>
    <!-- Base externe pour les tests d'intégration (fournie par -D ou un service CI). Vide = test neutralisé. -->
    <it.db.url/>
    <it.db.user/>
    <it.db.password/>
    <it.oracle.url/>
    <it.oracle.user/>
    <it.oracle.password/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web / API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Security : OAuth2 Resource Server (JWT Keycloak) (§4.2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Persistence : JPA (migrations executees par continuum-migrator, D33) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Modularite : frontieres de modules verifiees par les tests (§4.3.1) -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>

    <!-- Observabilite (§10) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Drivers : PostgreSQL et Oracle des le depart (D3) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Contrat OpenAPI (D32) → interfaces Spring générées. Package `gen.*` : hors périmètre
           Spring Modulith (base com.continuum) et non component-scanné (consommé comme une lib). -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.11.0</version>
        <executions>
          <execution>
            <id>generate-app-me</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/app/me.yaml.
                   Régénérer via `npx @redocly/cli bundle app/me.yaml -o …/src/main/openapi/me.bundled.yaml`.
                   Le bundle évite le mauvais nommage des schémas partagés au cross-ref, et garde le
                   build sans npx (air-gap, D26). -->
              <inputSpec>src/main/openapi/me.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.app.me.api</apiPackage>
              <modelPackage>gen.app.me.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-app-missions</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/app/missions.yaml.
                   Régénérer via `npx @redocly/cli bundle app/missions.yaml -o …/src/main/openapi/missions.bundled.yaml`. -->
              <inputSpec>src/main/openapi/missions.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.app.missions.api</apiPackage>
              <modelPackage>gen.app.missions.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-public</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/public/public.yaml. -->
              <inputSpec>src/main/openapi/public.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.pub.api</apiPackage>
              <modelPackage>gen.pub.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-app-findings</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/app/findings.yaml.
                   Régénérer via `npx @redocly/cli bundle app/findings.yaml -o …/src/main/openapi/findings.bundled.yaml`. -->
              <inputSpec>src/main/openapi/findings.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.app.findings.api</apiPackage>
              <modelPackage>gen.app.findings.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-app-ccm</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/app/ccm.yaml.
                   Régénérer via `npx @redocly/cli bundle app/ccm.yaml -o …/src/main/openapi/ccm.bundled.yaml`. -->
              <inputSpec>src/main/openapi/ccm.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.app.ccm.api</apiPackage>
              <modelPackage>gen.app.ccm.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-admin-iam</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/admin/tenancy-iam.yaml.
                   Régénérer via `npx @redocly/cli bundle admin/tenancy-iam.yaml -o …/src/main/openapi/admin-iam.bundled.yaml`. -->
              <inputSpec>src/main/openapi/admin-iam.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.admin.iam.api</apiPackage>
              <modelPackage>gen.admin.iam.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
          <execution>
            <id>generate-internal-keycloak</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <!-- Spec bundlée (redocly) : source = Instructions/contracts/openapi/internal/keycloak.yaml.
                   Régénérer via `npx @redocly/cli bundle internal/keycloak.yaml -o …/src/main/openapi/keycloak.bundled.yaml`. -->
              <inputSpec>src/main/openapi/keycloak.bundled.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <apiPackage>gen.internal.keycloak.api</apiPackage>
              <modelPackage>gen.internal.keycloak.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <documentationProvider>none</documentationProvider>
                <openApiNullable>false</openApiNullable>
                <useJakartaEe>true</useJakartaEe>
                <skipDefaultInterface>false</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <it.db.url>${it.db.url}</it.db.url>
            <it.db.user>${it.db.user}</it.db.user>
            <it.db.password>${it.db.password}</it.db.password>
            <it.oracle.url>${it.oracle.url}</it.oracle.url>
            <it.oracle.user>${it.oracle.user}</it.oracle.user>
            <it.oracle.password>${it.oracle.password}</it.oracle.password>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
